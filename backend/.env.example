SECRET_KEY=change-me-in-production
DB_ENGINE=sqlite
SQLITE_PATH=backend/instance/app.db

# PostgreSQL option
# DB_ENGINE=postgresql
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=code_red

# Full SQLAlchemy URL option
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/code_red

OTP_EXPIRY_SECONDS=300
AUTO_CREATE_TABLES=True
SEED_ON_STARTUP=True

# Celery & Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ciop_db
MONGO_ASSESSMENT_COLLECTION=assessment_questions
MONGO_ASSESSMENT_SUBMISSION_COLLECTION=assessment_submissions
MONGO_MATERIAL_SOURCE_COLLECTION=material_sources
MONGO_AI_SETTINGS_COLLECTION=ai_settings
USE_MONGO_MOCK=false
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_MAX_CONTEXT_CHUNKS=6
RAG_TEXT_MODEL=all-MiniLM-L6-v2
RAG_CLIP_MODEL=openai/clip-vit-base-patch32

# Gemini defaults for AI chatbot + assessment generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# API Configuration
API_PREFIX=/api
API_VERSION=v1

# Rate Limiting Configuration
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://localhost:6379/2
RATELIMIT_DEFAULT=200 per hour

# ============================================
# EMAIL CONFIGURATION (Gmail)
# ============================================

# Enable email functionality
EMAIL_ENABLED=true

# Sender identity
EMAIL_FROM_ADDRESS=dheerajkumarvishwakarma5@gmail.com
EMAIL_FROM_NAME=CIOP Platform

# SMTP Settings (Gmail)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=example@gmail.com
EMAIL_SMTP_PASSWORD=email password here
# Security
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false

# Debug: Include OTP in logs (set to false in production)
EMAIL_DEBUG_INCLUDE_OTP=false

# IMAP Settings (optional - for inbox sync)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=example@gmail.com
EMAIL_IMAP_PASSWORD=email password here
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_IMAP_USE_SSL=true
