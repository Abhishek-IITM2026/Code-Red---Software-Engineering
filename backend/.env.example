SECRET_KEY=change-me
DB_ENGINE=sqlite
SQLITE_PATH=backend/instance/app.db
AUTO_CREATE_TABLES=false
SEED_ON_STARTUP=false

# Preferred production option
# DB_ENGINE=postgresql
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=code_red

# Or provide a full SQLAlchemy URL directly
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/code_red

OTP_EXPIRY_SECONDS=300
API_PREFIX=/api
API_VERSION=v1

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ciop_db
MONGO_ASSESSMENT_COLLECTION=assessment_questions
USE_MONGO_MOCK=false

EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=no-reply@ciop.local
EMAIL_FROM_NAME=CIOP Platform
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_IMAP_USE_SSL=true
EMAIL_DEBUG_INCLUDE_OTP=true

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://localhost:6379/2
RATELIMIT_DEFAULT=200 per hour

# If Redis is not running locally, the app now falls back automatically to:
# CELERY_BROKER_URL=memory://
# CELERY_RESULT_BACKEND=cache+memory://
# RATELIMIT_STORAGE_URI=memory://
